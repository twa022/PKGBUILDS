pkgname=xenity-provides-zenity
pkgver=1
pkgrel=1
pkgdesc='Run zenity as xenity'
arch=('any')
url="none"
license=('GPL-2.0-or-later')
depends=(xenity)
provides=(zenity)
conflicts=(zenity)
source=()
sha256sums=()

package() {
  mkdir -p "${pkgdir}"/usr/bin/
  ln -s ./xenity "${pkgdir}"/usr/bin/zenity
}
